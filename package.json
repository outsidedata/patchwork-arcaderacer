{
  "name": "core",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.6"
  },
  "type": "module",
  "imports": {
    "#engine/*": "./engine/*",
    "#editor/*": "./editor/*",
    "#plugins/*": "./plugins/*",
    "#addons/*": "./addons/*",
    "#extensions/*": "./extensions/*",
    "#games/*": "./games/*",
    "#scripts/*": "./scripts/*"
  },
  "scripts": {
    "test": "vitest run",
    "test:view": "VIEW=1 vitest run --project view",
    "test:game": "GAME=1 vitest run --project game",
    "tsc": "tsc",
    "lint": "eslint .",
    "bake": "node --experimental-strip-types scripts/bake.ts",
    "health":"node --experimental-strip-types scripts/health.ts",
    "new-game": "node --experimental-strip-types scripts/new-game.ts",
    "produce_static_site": "node --experimental-strip-types scripts/produce_static_site.ts",
    "preview_loading": "echo 'the loading screen at http://localhost:8000/loading.html' && python3 -m http.server 8000 --bind 127.0.0.1 --directory scripts",
    "publish_gh_pages_game": "node --experimental-strip-types scripts/publish_gh_pages_game.ts",
    "editor": "node --watch --experimental-strip-types editor/server/server.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@types/three": "^0.186.0",
    "box2d.js": "github:outsidedata/box2d.js#db5c8b0",
    "box3d.js": "github:outsidedata/box3d.js#ed2c9ad",
    "codemirror": "^6.0.2",
    "dockview-react": "8.3.1",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "jsonc-parser": "3.3.1",
    "pixi.js": "^8.21.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "github:outsidedata/three.js#1f7e7c5",
    "tone": "15",
    "ws": "^8.18.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "2.1.9",
    "es-module-lexer": "^1.7.0",
    "esbuild": "^0.21.5",
    "eslint": "9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "gltfpack": "1.3.0",
    "jsdom": "25",
    "lil-gui": "^0.21.0",
    "node-web-audio-api": "^2.2.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
