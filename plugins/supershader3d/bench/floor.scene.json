    "environment3d": {
      "sun": { "at": [200, 300, -150], "color": "#fff3df", "power": 2.6 },
      "sky": { "color": "#cfe0f2", "ground": "#5a5048", "power": 0.9 },
      "ambient": { "color": "#ffffff", "power": 0.15 }
    },
    "swatch": { "material": "none" }
  },
  "actors": [{ "is": "scenemanager" }, { "is": "loader" }, { "is": "swatch" }]
