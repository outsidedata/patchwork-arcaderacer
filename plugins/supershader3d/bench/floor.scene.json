{
  "world": {
    "loader": { "assets": {} },
    "supershader3d": { "looks": "looks" }
  },
  "plugins": ["loader", "scenemanager", "supershader3d", "environment3d", "render3d"],
  "seats": 1,
  "prefabs": {
    "engine": { "dt": 0.016666666666666666, "width": 1280, "height": 800 },
    "scenemanager": { "out": {} },
