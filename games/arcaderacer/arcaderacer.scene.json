    "ui": {
      "mods": { "behaviors": ["loader"] },
      "panels": {
        "loading": {
          "anchor": "center",
          "size": [1280, 720],
          "layer": 100,
          "modal": true,
          "loading": {
            "fill": { "color": 659500 },
            "bar": {
              "at": [340, 600],
              "size": [600, 14],
              "edge": 2,
              "frame": { "color": 1118481 },
              "track": { "color": 3355443 },
              "fill": { "color": 16769280 }
            },
            "lines": {
              "style": "tagline",
              "at": [640, 650],
              "every": 4,
              "text": [
                { "text": "Turn and tap the brake or handbrake to start a drift.", "picture": "ar4" },
                { "text": "A drift that touches no wall or car earns boost.", "picture": "ar3" },
                { "text": "Touching a wall or a car spoils the drift's boost.", "picture": "ar1" },
                { "text": "Keep a drift clear of walls and cars and the boost is yours.", "picture": "ar2" }
              ]
            },
            "shaders": { "style": "tagline", "at": [640, 650], "text": "Compiling shaders" },
            "fade": 0.8
          }
        },
        "hud": {
          "anchor": "top-left",
          "size": [
            1280,
            720
          ]
        },
        "title": {
          "anchor": "center",
          "size": [
            1280,
            720
          ],
          "modal": true
        },
        "watch": {
          "anchor": "top-left",
          "size": [
            1280,
            720
          ]
        },
        "results": {
